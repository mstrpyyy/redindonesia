// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model SocialAccount {
  id         String   @id @default(cuid())
  platform   String // "instagram" | "tiktok" | "facebook" | etc.
  label      String // display name, e.g. "Radian Elok Distriversa"
  profileImg String // relative path under /uploads/social-accounts, e.g. "/uploads/social-accounts/abc123.jpg"
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  images      String[] // relative paths under /uploads/galleries, e.g. "/uploads/galleries/abc123.jpg"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Self-referential tree backing the admin-managed "Devices" and "Products"
// menus (see ADR-019). `type` roots the tree ("device" | "product", same
// string-enum convention as Article.status) — depth 1 nodes have parentId
// null. `depth` (1-3) is stored rather than derived so the max-depth-3 rule
// can be enforced with a single read instead of a recursive parent walk.
// Sibling slug uniqueness is enforced in the server action, not here: a
// unique([type, parentId, slug]) index can't work because Postgres never
// treats NULL as equal to NULL, so it wouldn't catch duplicate depth-1 slugs
// (which all share parentId = null).
model Category {
  id                String         @id @default(cuid())
  type              String
  name              String
  slug              String
  depth             Int
  order             Int            @default(0)
  parentId          String?
  parent            Category?      @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]     @relation("CategoryChildren")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  products          Product[]
  homeCarousels     HomeCarousel[]
  // Cross-listing only — see `Product.secondaryCategories` (ADR-085).
  secondaryProducts Product[]      @relation("ProductSecondaryCategories")

  // A node is either a real page (banner/title/description required, body/
  // youtubeUrl optional) or stays a plain breadcrumb (all fields null) — see
  // ADR-033. `name`/slug still drive the tree and breadcrumb regardless of
  // `isPage`; `title` is the page's own heading, deliberately separate so it
  // can read differently from the compact nav label.
  //
  // Four banner sizes, one per orientation/breakpoint, mirroring the
  // hardcoded sm/md/lg/xl banner images the homepage/about hero sections
  // already use (see ADR-035): bannerXlUrl (1920x1080, desktop landscape) is
  // the only one required — the others fall back to it on the public side.
  isPage              Boolean @default(false)
  bannerSmUrl         String? // 1080x1920 — mobile portrait
  bannerSmVideoUrl    String? // optional MP4 paired with bannerSmUrl — see ADR-093
  bannerMdUrl         String? // 1080x1440 — tablet portrait
  bannerMdVideoUrl    String?
  bannerLgUrl         String? // 1440x1080 — tablet/small-desktop landscape
  bannerLgVideoUrl    String?
  bannerXlUrl         String? // 1920x1080 — desktop landscape, required when isPage
  bannerXlVideoUrl    String?
  // One global switch, not per-size — same cascade pattern as HomePage's own
  // banner video (ADR-091), reused here rather than re-invented — see ADR-093.
  bannerVideoUseForSmaller Boolean @default(false)
  title               String?
  description         String?
  body                String? @db.Text
  youtubeUrl          String?
  // All optional regardless of `isPage` — a page can have a YouTube URL with
  // no extra media dressing. `youtubeThumbnailUrl` is a custom poster shown
  // with a click-to-play overlay instead of the iframe loading immediately;
  // unset falls back to embedding the iframe directly, same as before this
  // field existed. `youtubeCaption`/`youtubeDescription` are a short heading
  // (h3) and paragraph (p) shown alongside the video.
  youtubeThumbnailUrl String?
  youtubeCaption      String?
  youtubeDescription  String?
  // One of HERO_TEXT_COLOR_VALUES (src/lib/hero-text-colors.ts). Nullable so
  // rows created before this column falls back to the same peach the hero
  // was hardcoded to before this was admin-editable (ADR-045).
  heroTextColor       String?

  @@index([type, parentId])
}

// A device/product detail entry, assigned to any single `Category` node
// (not necessarily a depth-3 leaf — some brands have no sub-brand level and
// need products attached directly at depth 2, see ADR-020). `segments` is an
// ordered array of typed content blocks (hero, highlight, treatments grid,
// 360 viewer, tech spec accordion, applicator carousel, before/after,
// document download — see src/interfaces/segments.ts for the exact shapes)
// rather than one column per section: the public detail page's sections are
// each a different repeating shape and vary per product (some skip a 360
// viewer, some have two before/after blocks), so a fixed relational schema
// would mean a migration every time a new section style is needed. Same
// "JSON over exploding into join tables" precedent as Gallery.images
// (ADR-011), just one level richer.
model Product {
  id                  String     @id @default(cuid())
  type                String
  name                String
  slug                String
  tagline             String?
  thumbnail           String?
  // One of CARD_BACKGROUND_VALUES (src/lib/card-backgrounds.ts). Nullable so
  // rows created before this column fall back to the default tint.
  cardBackground      String?
  segments            Json       @default("[]")
  // "hidden" | "public" — renamed from draft/published (ADR-040); a hidden
  // item is a work in progress, only enforced complete once made public.
  status              String     @default("hidden")
  // When true (and `status` is "public"), this product is spliced into its
  // category's navbar dropdown as its own named menu item (ADR-086) — an
  // alternative to modeling every product as its own `Category` node just to
  // get a name in the menu. Per-product rather than a category-wide switch so
  // an admin can pick which products actually warrant a menu entry.
  showInMenu          Boolean    @default(false)
  order               Int        @default(0)
  categoryId          String
  category            Category   @relation(fields: [categoryId], references: [id])
  // Cross-listing only, never the routing/canonical category — `categoryId`
  // above is always the one that drives this product's own URL/breadcrumb
  // (see ADR-038). A product can additionally show up on other category
  // pages' product grids via this list. See ADR-085.
  secondaryCategories Category[] @relation("ProductSecondaryCategories")
  // Flat and reusable within its own type, unlike `Category` (a tree, one per
  // product, drives the page's own URL) — tags are purely for
  // filtering/discovery. Scoped to `type` the same way `Category` is: a
  // "Dermatology" product tag and a "Dermatology" device tag are two
  // distinct rows, never shared. See ADR-041.
  tags                Tag[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([type, categoryId])
}

// A single homepage carousel section (see ADR-066). Two mutually exclusive
// authoring modes, discriminated by `mode`:
// - "category": a leaf `Category` node (no children) drives everything —
//   title, product list, and the "See More" link are all resolved live from
//   the category at render time, never snapshotted. `title`/`seeMoreUrl`/
//   `items` are unused (null/default) in this mode.
// - "custom": the admin fills every field by hand. `items` is an ordered
//   array of `{ id, title, img, href }` (see `ICarouselItem`,
//   src/interfaces/general.ts) — JSON over a join table for the same reason
//   as Gallery.images/Product.segments (ADR-011/ADR-020): a small ordered
//   list with no independent query need of its own.
// `categoryId` is nullable + `onDelete: SetNull` rather than `Cascade` — a
// deleted category leaves the carousel row in place (surfaced in the admin
// as "category missing," matching the document-picker precedent in ADR-051)
// instead of silently deleting a homepage section out from under the admin.
model HomeCarousel {
  id               String    @id @default(cuid())
  mode             String
  order            Int       @default(0)
  size             String    @default("md")
  showSeeMore      Boolean   @default(true)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String?
  seeMoreUrl       String?
  items            Json      @default("[]")
  // "text" | "image" — independent of `mode` (see ADR-066). "image" swaps the
  // visible heading for `titleImage` (e.g. a brand logo) while the text title
  // (`title` here, or the category's own `name` in "category" mode) still
  // renders as a screen-reader-only heading — `ProductHomeSection` already
  // does this unconditionally, so no public component change was needed to
  // support it.
  titleDisplayMode String    @default("text")
  titleImage       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([categoryId])
}

// Reuse is enforced in code, not just the DB constraint (`createTag` in
// tag-actions.ts does a case-insensitive lookup, scoped to `type`, before
// creating) — see ADR-041 for why a case-sensitive `@@unique` alone isn't
// enough on its own to prevent near-duplicates like "Dermatology"/"dermatology".
model Tag {
  id        String    @id @default(cuid())
  type      String
  name      String
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([type, name])
}

// One row per static support page (Registration & Documentation, Warranty &
// Service, Career — Marcom & Promotion keeps its own SocialAccount-driven
// content instead). `slug` is a fixed key (one of SUPPORT_PAGE_SLUGS,
// src/lib/support-pages.ts), not a public catalogue slug like
// Category/Product — there is never a list or an add/delete flow, only
// upsert-by-slug from the admin form. Banner fields are nullable (a row
// might not exist yet before the first save) even though bannerXlUrl is
// required in practice — that's enforced by the save Server Action's Zod
// schema, not the DB, same reasoning as Category's isPage-gated fields.
model SupportPage {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  bannerXlUrl              String? // 1920x830 — required
  bannerXlVideoUrl         String? // optional mp4, falls back to bannerXlUrl as poster/no-video image
  bannerMdUrl              String? // 1080x878 — optional
  bannerMdVideoUrl         String? // optional mp4, falls back to bannerMdUrl as poster/no-video image
  bannerSmUrl              String? // 1080x1080 — optional
  bannerSmVideoUrl         String? // optional mp4, falls back to bannerSmUrl as poster/no-video image
  bannerVideoUseForSmaller Boolean  @default(false) // Xl → Md → Sm waterfall, see ADR-091/ADR-092
  body                     String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Same shape as SupportPage (ADR-070) for the admin Contact dashboard's
// "Content" submenu — one row per fixed slug (currently only `content`,
// CONTACT_PAGE_SLUGS in src/lib/contact-pages.ts), upserted, no add/delete
// flow. "Form Response" is a separate submenu with no model yet.
model ContactPage {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  bannerXlUrl              String? // 1920x830 — required
  bannerXlVideoUrl         String? // optional mp4, falls back to bannerXlUrl as poster/no-video image
  bannerMdUrl              String? // 1080x878 — optional
  bannerMdVideoUrl         String? // optional mp4, falls back to bannerMdUrl as poster/no-video image
  bannerSmUrl              String? // 1080x1080 — optional
  bannerSmVideoUrl         String? // optional mp4, falls back to bannerSmUrl as poster/no-video image
  bannerVideoUseForSmaller Boolean  @default(false) // Xl → Md → Sm waterfall, see ADR-091/ADR-092
  body                     String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// One row per public /contact form submission (see ADR-073). Append-only —
// no edit flow, so no updatedAt. Feeds the admin Contact dashboard's "Form
// Response" list/detail view (ADR-075). `isRead` flips true the first time
// an admin opens a submission (markContactSubmissionAsRead) — shared state
// across the one admin login, not per-browser, since there's no per-user
// session to key it on.
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  question  String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Public /media/podcasts page banner — same upsert-by-fixed-slug pattern as
// ContactPage/SupportPage (ADR-070/072): one row, no add/delete flow. See
// ADR-076.
model PodcastPage {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  bannerXlUrl              String? // 1920x830 — required
  bannerXlVideoUrl         String? // optional mp4, falls back to bannerXlUrl as poster/no-video image
  bannerMdUrl              String? // 1080x878 — optional
  bannerMdVideoUrl         String? // optional mp4, falls back to bannerMdUrl as poster/no-video image
  bannerSmUrl              String? // 1080x1080 — optional
  bannerSmVideoUrl         String? // optional mp4, falls back to bannerSmUrl as poster/no-video image
  bannerVideoUseForSmaller Boolean  @default(false) // Xl → Md → Sm waterfall, see ADR-091/ADR-092
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Public /media/articles page banner — same upsert-by-fixed-slug pattern as
// PodcastPage/ContactPage/SupportPage (ADR-070/072/076): one row, no
// add/delete flow. See ADR-081.
model ArticlesPage {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  bannerXlUrl              String? // 1920x830 — required
  bannerXlVideoUrl         String? // optional mp4, falls back to bannerXlUrl as poster/no-video image
  bannerMdUrl              String? // 1080x878 — optional
  bannerMdVideoUrl         String? // optional mp4, falls back to bannerMdUrl as poster/no-video image
  bannerSmUrl              String? // 1080x1080 — optional
  bannerSmVideoUrl         String? // optional mp4, falls back to bannerSmUrl as poster/no-video image
  bannerVideoUseForSmaller Boolean  @default(false) // Xl → Md → Sm waterfall, see ADR-091/ADR-092
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Public /media/galleries page banner — same shape as ArticlesPage. See
// ADR-081.
model GalleriesPage {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  bannerXlUrl              String? // 1920x830 — required
  bannerXlVideoUrl         String? // optional mp4, falls back to bannerXlUrl as poster/no-video image
  bannerMdUrl              String? // 1080x878 — optional
  bannerMdVideoUrl         String? // optional mp4, falls back to bannerMdUrl as poster/no-video image
  bannerSmUrl              String? // 1080x1080 — optional
  bannerSmVideoUrl         String? // optional mp4, falls back to bannerSmUrl as poster/no-video image
  bannerVideoUseForSmaller Boolean  @default(false) // Xl → Md → Sm waterfall, see ADR-091/ADR-092
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Homepage hero banner, admin-managed under Homepage → Content (see
// ADR-082). One row, upserted by fixed slug (src/lib/home-page.ts) — same
// upsert-by-slug pattern as ContactPage/SupportPage. Four banner sizes, one
// per orientation/breakpoint, reusing the exact set Category already
// established (ADR-035): only bannerXlUrl is required.
// Each size can optionally be an mp4 video instead of a still image (see
// ADR-089) — bannerXxxVideoUrl holds the video; bannerXxxUrl becomes that
// size's required poster/fallback image when a video is set (still image-only
// otherwise). Not a type discriminator column — presence of the video URL is
// the signal.
// The four sizes form one waterfall, largest to smallest: Xl, Lg, Md, Sm — see
// ADR-091. One global `bannerVideoUseForSmaller` flag (not per-size): when
// true, each size's own video is also carried down through every smaller
// size that has none of its own, UNTIL a smaller size with its own video is
// reached — that size's own video always wins there and continues the
// cascade from itself. When false, every size shows only its own video (or
// none). Only meaningful, and only enabled in the admin UI, once at least one
// size actually has a video.
model HomePage {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  bannerSmUrl              String? // 1080x1920 — mobile portrait, smallest, nothing to cascade to
  bannerSmVideoUrl         String? // optional mp4, falls back to bannerSmUrl as poster/no-video image
  bannerMdUrl              String? // 1080x1440 — tablet portrait
  bannerMdVideoUrl         String? // optional mp4, falls back to bannerMdUrl as poster/no-video image
  bannerLgUrl              String? // 1440x1080 — tablet/small-desktop landscape
  bannerLgVideoUrl         String? // optional mp4, falls back to bannerLgUrl as poster/no-video image
  bannerXlUrl              String? // 1920x1080 — desktop landscape, required
  bannerXlVideoUrl         String? // optional mp4, falls back to bannerXlUrl as poster/no-video image
  bannerVideoUseForSmaller Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// One podcast episode shown on /media/podcasts — admin-managed add/edit/
// delete/reorder list. Same shape as Gallery (ADR-011) minus the image grid,
// since a podcast's only media is its YouTube video. See ADR-076.
// `thumbnailUrl` is optional admin-uploaded artwork, not yet rendered on the
// public page (only stored/editable so far) — see ADR-077.
model Podcast {
  id           String   @id @default(cuid())
  youtubeUrl   String
  title        String
  description  String?
  thumbnailUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
